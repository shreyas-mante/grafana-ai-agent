# Copy to .env.local (git-ignored) or set these in your host's secret settings.
# Generate keys with: scripts/gen-keys.sh

# --- Platform ---
DATABASE_URL=            # postgres://... (Neon). Empty = embedded H2 file (local only)
APP_PUBLIC_URL=http://127.0.0.1:8080
APP_SIGNUP=invite        # invite | open | closed
APP_ENCRYPTION_KEY=      # random, 32+ chars; encrypts saved integration secrets

# --- Bootstrap workspace keys (optional) ---
# SHA-256 hashes of your keys (the plain keys are never stored on the server)
APP_ADMIN_KEY_SHA256=
APP_INGEST_KEY_SHA256=
# Random string, at least 32 characters, used to sign session cookies
APP_SESSION_SECRET=

# --- Defaults for the bootstrap workspace only (others use Settings in the UI) ---
# AI (free key from https://aistudio.google.com/apikey). Empty = offline mode
GEMINI_API_KEY=
APP_LLM_MODEL=gemini-2.5-flash

# --- Prometheus to investigate ---
APP_PROMETHEUS_URL=http://localhost:9090
# Grafana Cloud: username = Prometheus instance ID, token = access policy token (metrics:read)
APP_PROMETHEUS_USERNAME=
APP_PROMETHEUS_TOKEN=

# --- Optional: forward local demo metrics to Grafana Cloud (used by scripts/dev.sh) ---
# GC_REMOTE_WRITE_URL=https://prometheus-prod-XX-prod-XX.grafana.net/api/prom/push
# GC_USERNAME=<instance ID>
# GC_WRITE_TOKEN=<access policy token with metrics:write>
# Send demo errors to your hosted PulseAgent instead of localhost:
# PULSEAGENT_ENDPOINT=https://your-app.onrender.com

# --- Source code for exact line, author and commit (pick one) ---
# GitHub: a fine-grained, read-only token with "Contents: read" and "Pull requests: read"
APP_GITHUB_REPO=owner/repo
GITHUB_TOKEN=
# Or a local git checkout
APP_CODE_REPO_PATH=
APP_CODE_PACKAGES=com.demo
